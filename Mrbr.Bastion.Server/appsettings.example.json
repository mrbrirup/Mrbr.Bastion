{
  "Kestrel": {
    "Endpoints": {
      "Https": { "Url": "https://localhost:7443", "Protocols": "Http1AndHttp2" }
    }
  },
  "Bastion": {
    "DatabasePath": "data/ingestion.db",
    "ReceiptSigningPrivateKeyPath": "keys/receiver-private.pem",
    "ReceiptVerificationPublicKeyPaths": [],
    "Nodes": [
      {
        "NodeId": "server-01",
        "LedgerId": "REPLACE-WITH-THE-OUTBOX-LEDGER-GUID",
        "PublicKeys": [ { "Path": "keys/node-public.pem" } ]
      }
    ],
    "AllowInsecureLoopback": false,
    "MaximumConcurrentRequests": 32,
    "MaximumStoredPayloadBytes": 4294967296,
    "AuditDatabasePath": "data/audits.db",
    "MaximumStoredAudits": 100000,
    "MaximumStoredAuditBytes": 1073741824,
    "MaximumConcurrentAuditRequests": 16,
    "AuditChallengeLifetimeSeconds": 60,
    "HeartbeatStaleAfterSeconds": 90,
    "HeartbeatOfflineAfterSeconds": 300,
    "Notifications": {
      "Enabled": false,
      "DatabasePath": "data/notifications.db",
      "MaximumStoredDeliveries": 100000,
      "MaximumReservedBytes": 1073741824,
      "MaximumAttempts": 8,
      "MaximumManualRedrives": 3,
      "PollIntervalSeconds": 5,
      "AttemptTimeoutSeconds": 30,
      "LeaseDurationSeconds": 60,
      "InitialRetryDelaySeconds": 5,
      "MaximumRetryDelaySeconds": 900,
      "Email": [],
      "Webhooks": []
    },
    "Dashboard": {
      "Enabled": false,
      "AuthenticationMode": "Users",
      "OperatorDatabasePath": "data/operators.db",
      "SessionMinutes": 480,
      "MaximumUsers": 10000,
      "MaximumSecurityEvents": 1000000,
      "MaximumOperatorSessions": 50000,
      "DatabasePath": "data/alerts.db",
      "MaximumStoredAlerts": 100000,
      "AlertEvaluationIntervalSeconds": 15
    }
  }
}
